# =============================================================================
# Required (at least one)
# =============================================================================

# Google Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API key: https://console.groq.com/keys
# When set, Groq powers answer generation (OpenAI-compatible endpoint),
# even without a Gemini key. Ideal for a zero-cost, real-LLM deployment.
GROQ_API_KEY=

# Upstash Vector: https://upstash.com -> Create Vector Database
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis: https://upstash.com -> Create Redis Database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Optional (defaults shown)
# =============================================================================

# Embedding provider:
#   auto   -> Gemini when GEMINI_API_KEY is set, else the local model
#   gemini -> Google Gemini embeddings (needs GEMINI_API_KEY)
#   local  -> in-process transformer, no API key required (default when no key)
#   mock   -> deterministic hash vectors (CI / offline only)
EMBEDDING_PROVIDER=auto

# In-process embedding model (used by the "local" provider). BGE-base is
# 768-dim, so your Upstash Vector index must also be 768-dim. For a lighter
# cold start, use Xenova/bge-small-en-v1.5 with EMBEDDING_DIM=384.
LOCAL_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5

# Gemini embedding model + vector dimension. EMBEDDING_DIM must match your
# vector index's dimension. Hybrid (dense + sparse) indexes are auto-detected:
# the app supplies a dense vector AND a custom BM25-style sparse vector, and
# zero-pads/truncates the dense vector to fit. Example: a 1536-dim hybrid index
# uses BGE-base (768) zero-padded to 1536 -> set EMBEDDING_DIM=1536.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Optional: writable cache dir for the local model (serverless uses /tmp).
# TRANSFORMERS_CACHE=/tmp/hf-cache

# Chunking (in approximate tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# LLM (Gemini)
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# Groq model (used when GROQ_API_KEY is set)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Retrieval
TOP_K=8
MIN_RELEVANCE_SCORE=0.5

# Rate limit per IP per minute
RATE_LIMIT_PER_MINUTE=60

# Set to "false" in production to disable mock-mode fallback
ALLOW_MOCK_MODE=true